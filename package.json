{
  "name": "tick-tones",
  "version": "1.8.1",
  "description": "Plays a tone when you tick a checkbox.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version-bump": "node version.mjs bump",
    "lint": "bun x biome check .",
    "lint-fix": "bun x biome check --write .",
    "test": "bun test"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin"
  ],
  "author": "DontBlameMe",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DontBlameMeDev/Tick-Tones.git"
  },
  "homepage": "https://github.com/DontBlameMeDev/Tick-Tones#readme",
  "bugs": {
    "url": "https://github.com/DontBlameMeDev/Tick-Tones/issues"
  },
  "packageManager": "bun@1.3.12",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.0.0",
    "bun-types": "^1.3.14",
    "esbuild": "^0.28.1",
    "obsidian": "^1.13.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "semver": "^7.8.5",
    "tslib": "^2.8.1"
  }
}
