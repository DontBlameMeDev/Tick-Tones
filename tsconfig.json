{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "main": ["./main.ts"],
      "__mocks__/*": ["./__mocks__/*"],
      "src/*": ["./src/*"],
      "tests/*": ["./tests/*"]
    },
    "types": ["bun-types", "node"],
    "allowJs": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "importHelpers": true,
    "sourceMap": true,
    "inlineSources": true,
    "lib": ["DOM", "ES2022"],
    "skipLibCheck": true
  },
  "include": ["main.ts", "src/**/*.ts", "test/**/*.ts"]
}
